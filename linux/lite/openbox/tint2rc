# NEXUS Lite minimal tint2 panel (zero blur/compositing overhead)
rounded = 6
border_width = 1
background_color = #0d1424 95
border_color = #66a3ff 35

panel_items = LTSC
panel_size = 100% 34
panel_margin = 0 0
panel_padding = 6 2 6
panel_background_id = 1
panel_position = bottom center horizontal
panel_layer = top

taskbar_mode = single_desktop
taskbar_padding = 2 2 4
task_background_id = 0
task_font_color = #eef4ff 90
task_active_font_color = #66a3ff 100

systray_padding = 4 2 4
clock_format = %H:%M
clock_font_color = #eef4ff 100
time1_format = %H:%M
launcher_item_app = /usr/local/share/applications/nexus-files.desktop
launcher_item_app = /usr/local/share/applications/nexus-terminal.desktop
launcher_item_app = /usr/local/share/applications/nexus-settings.desktop
launcher_item_app = /usr/local/share/applications/nexus-store.desktop
launcher_item_app = /usr/local/share/applications/nexus-installer.desktop
