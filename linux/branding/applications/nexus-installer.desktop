[Desktop Entry]
Version=1.0
Type=Application
Name=Install NEXUS OS
Comment=Launch hardware preflight and the Linux Mint Ubiquity installer for NEXUS OS
Exec=/usr/local/bin/nexus-installer-launcher --launch
Icon=/usr/local/share/nexus-os/nexus-logo.svg
Terminal=false
Categories=System;Settings;
StartupNotify=true
