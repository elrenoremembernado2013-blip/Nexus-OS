[Desktop Entry]
Type=Application
Version=1.0
Name=NEXUS Hardware Diagnostics
Comment=Run read-only, privacy-preserving hardware compatibility & diagnostics preview
Exec=sh -c '/usr/local/bin/nexus-hw-diagnostics --preview; printf "\nPress Enter to close..."; read -r _'
Icon=computer
Terminal=true
Categories=System;Utility;
Keywords=hardware;diagnostics;drivers;wifi;audio;gpu;
