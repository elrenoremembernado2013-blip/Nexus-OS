[Desktop Entry]
Type=Application
Name=NEXUS Settings
Comment=Configure Linux Mint display, network, sound, and desktop preferences
Exec=sh -c 'command -v cinnamon-settings >/dev/null 2>&1 && exec cinnamon-settings || exec xfce4-settings-manager'
Icon=preferences-system
Terminal=false
Categories=Settings;DesktopSettings;
StartupNotify=true
